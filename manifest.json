{
  "manifest_version": 3,
  "name": "Saurus",
  "version": "0.1.0",
  "description": "A patient language tutor that lives in your browser. Press Alt+S to call Saurus.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "supabase-config.js",
        "backend.js",
        "backend-gemini.js",
        "backend-mock.js",
        "saurus.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
