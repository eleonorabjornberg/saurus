{
  "manifest_version": 3,
  "name": "Saurus",
  "version": "0.1.0",
  "description": "A patient language tutor that lives in your browser. Press Alt+S to call Saurus.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "supabase-config.js",
        "auth-bridge.js",
        "backend.js",
        "backend-gemini.js",
        "backend-mock.js",
        "saurus.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/saurus-16.png",
    "32": "icons/saurus-32.png",
    "48": "icons/saurus-48.png",
    "128": "icons/saurus-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/saurus-16.png",
      "32": "icons/saurus-32.png",
      "48": "icons/saurus-48.png"
    },
    "default_title": "Saurus: sign in, then press Alt+S on any page",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html"
}
